[
  {
    "id": "global-cross-container-recall",
    "description": "Global memory ingested in container A should be visible from container B with matching actor",
    "steps": [
      {
        "action": "ingest",
        "item": {
          "source_type": "chat_message",
          "source_id": "global-scenario-1",
          "content_type": "text/plain",
          "content": "Decision: always use tabs for indentation across all projects",
          "role": "user",
          "container_ref": "git:repo-alpha",
          "thread_ref": "git:repo-alpha:thread-1",
          "actor_ref": "alice",
          "visibility": "global",
          "artifact_kind": "message"
        }
      },
      {
        "action": "query",
        "query": {
          "text": "what indentation style should I use for tabs or spaces?",
          "container_ref": "git:repo-beta",
          "actor_ref": "alice",
          "visibility": "private",
          "limit": 10
        }
      }
    ],
    "invariants": ["INV-14", "INV-15"],
    "expect_results": true
  },
