{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [{
          "type": "command",
          "command": "python3 hooks/session_start.py",
          "timeout": 8,
          "statusMessage": "Loading memory"
        }]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [{
          "type": "command",
          "command": "python3 hooks/user_prompt_submit.py",
          "timeout": 8,
          "statusMessage": "Retrieving memory"
        }]
      }
    ],
    "Stop": [
      {
        "hooks": [{
          "type": "command",
          "command": "python3 hooks/stop.py",
          "timeout": 15
        }]
      }
    ]
  }
}
