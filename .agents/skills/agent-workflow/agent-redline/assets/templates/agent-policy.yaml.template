# agent-policy.yaml — generated by agent-redline bootstrap
#
# This is a starting template. Bootstrap fills it in based on inspection
# of the consuming repo. The shape is normative (see docs/POLICY_SCHEMA.md);
# the values are repo-specific.
#
# After bootstrap, treat this file as red-zone: changes to it should go
# through architecture-review.

version: 1

project:
  name: <repo-name>
  extension: <extension-name>           # e.g. jvm-archunit; or omit for zone-only

zones:
  red:
    # Architecture-test definition files MUST be red. Without this entry,
    # an agent could weaken the boundary backend silently.
    - path: <arch-test-glob>
      reason: dependency-rule definitions; weakening these requires explicit checkpoint
      checkpoint: architecture-review
    # Add the actual zones from the language extension's profile.md, with
    # paths substituted for the repo's real package names.
    # - path: src/main/java/**/domain/**
    #   reason: domain model and invariants
    #   checkpoint: architecture-review

  blue:
    - path: src/test/**
      reason: tests (excluding architecture/**)
    - path: docs/**
      reason: documentation
    - path: .claude/**
      reason: installed agent-workflow skill files (bootstrap writes them here)

  # `watch` is optional — a list of additive tags that surface in PR
  # comments regardless of zone classification, no checkpoint. Bootstrap
  # populates this from the extension's profile.md when relevant. When
  # populated, every entry needs both `path` and `reason`. Example:
  # watch:
  #   - path: src/main/java/**/*Controller.java
  #     reason: controller change; structural API impact surfaced via OpenAPI diff

# boundaries describe forbidden dependencies. The language extension's
# boundary-rule backend (e.g. ArchUnit) enforces them; the reporter
# surfaces the configured rules and reads backend output.
# boundaries:
#   - id: domain-must-not-import-adapters
#     description: Domain layer must not depend on adapter implementations
#     from: src/main/java/**/domain/**
#     forbidImports:
#       - src/main/java/**/adapter/**
#     severity: error

# api: { type: none }
# persistence: { migrationPaths: [...] }
# security: { paths: [...] }
# runtimeConfig: { paths: [...] }

prRules:
  maxChangedFiles:
    warn: 50
    fail: 100
  maxLinesChanged:
    warn: 1000
    fail: 2000

checkpoints:
  architecture-review:
    description: Architecture review for structural changes
    satisfiedBy:
      - codeownerApproval
      - label: architecture-reviewed
  # Add others as needed:
  # api-review, persistence-review, security-review, ops-review

modes:
  default: shadow
  perCheck:
    boundary_violation: binding
    # suppression: binding   # hardcoded default; uncomment to make explicit

# suppressions:
#   useExtensionDefaults: true
#   exemptPaths:
#     - "**/tests/**"

# The agent-workflow bookkeeping folder is excluded by default by the redline
# reporter (it's the review artifact, not a review surface). This explicit
# entry documents that and covers standalone-redline installs running an older
# reporter without the built-in default. Work Record *content* is still
# validated by the agent-workflow checker's own predicates. If you relocate
# Work Records outside `.agent-workflow/` (a non-default taskPath), add that
# path here too — the default only covers the conventional folder.
excludes:
  - ".agent-workflow/**"
#   - src/main/generated/**
#   - build/**
