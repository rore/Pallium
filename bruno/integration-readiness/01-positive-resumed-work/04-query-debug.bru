meta {
  name: Positive Query Debug
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/query/debug
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "text": "What blocker did we hit, what progress was preserved, and what should we do next on the catalog sync retry?",
    "limit": 6,
    "container_ref": "chat:integration-readiness",
    "visibility": "public"
  }
}
