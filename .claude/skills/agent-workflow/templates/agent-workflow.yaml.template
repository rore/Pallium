# agent-workflow.yaml — generated by agent-workflow bootstrap
#
# This file IS REQUIRED when agent-workflow operates on a repository.
# It tells the skill and the CI checker where the Work Record lives
# (local Markdown file vs Jira) and which path template applies.
#
# Schema: see core/schema/agent-workflow.schema.json (or vendored copy).

version: 1

project:
  name: <repo-name>

# Work Record backend selection + backend-specific options. Bootstrap
# proposes one shape; the human confirms.
#
# One backend is supported today:
#   local — Markdown file in this repo. Required for all current
#           installs (POC and pre-Jira repositories).
#
# A second backend shape is reserved in the schema but not yet
# implemented:
#   jira  — marker-bounded comment on a Jira ticket. Lands with
#           slice W18; do NOT select today (the loader surfaces it
#           as an obvious half-config failure).
workRecord:
  backend: local
  local:
    # Repo-relative path template. {slug} is substituted from the
    # branch name (slice/, feat/, fix/, etc. stripped; '/' → '-').
    taskPath: ".agent-workflow/tasks/{slug}.md"

# agent-redline integration. Required by default — the CI checker
# treats a missing redline verdict as a CI configuration error. Set
# to 'optional' only when this repository deliberately opts out.
redline: required

# Where the CI checker looks for redline's verdict JSON artifact.
# Default: build/redline-verdict.json. Adjust if the redline CI job
# writes to a different path.
redlineVerdictPath: build/redline-verdict.json

# Claude Code accelerator hooks (optional; a turn-time nudge, not the
# enforcement floor — CI stays that). The plan-mode gate requires a plan
# to include the Work Record step when it touches guarded code. Bootstrap
# detects this repo's code root(s) and fills guardedPaths below; if the
# key is absent the gate defaults to ["src/"]. Prefixes match on a path
# boundary, case-insensitively.
hooks:
  guardedPaths:
    - "src/"

# Additional fields are optional and only act when their consuming
# work item lands. Examples (commented out — uncomment what applies):
#
# verification:
#   commands:
#     - ./gradlew test
#     - ./gradlew spotlessApply
#
# reviewers:
#   high:
#     - "@team-architects"
