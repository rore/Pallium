# Copy this file to .env.local for local development.
# Environment variables still override values from .env.local.

PALLIUM_DEFAULT_USE_CASE=demo_agent_memory
PALLIUM_STORAGE_BACKEND=sqlite
PALLIUM_SQLITE_URL=sqlite:///./pallium.db

# LLM-backed semantic path
# PALLIUM_DEFAULT_USE_CASE=agent_conversation_memory
# PALLIUM_LLM_PROVIDER=openai_compatible
# PALLIUM_LLM_MODEL=gpt-5-mini
# PALLIUM_LLM_BASE_URL=https://api.openai.com/v1
# PALLIUM_LLM_API_KEY=your-key
# PALLIUM_LLM_PROMPT_VARIANT=strict_typed_memory_v4_evidence_guarded
# PALLIUM_LLM_TIMEOUT_SECONDS=30

# Claude-compatible example
# PALLIUM_LLM_PROVIDER=anthropic_claude
# PALLIUM_LLM_MODEL=claude-3-5-sonnet-latest
# PALLIUM_LLM_BASE_URL=https://api.anthropic.com/v1
