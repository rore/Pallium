# Copy this file to .env.local for local development secrets and one-off overrides.
# Use pallium.local.toml for package/provider structure.
# Environment variables still override values from .env.local and pallium.local.toml.

PALLIUM_OPENAI_API_KEY=your-key

# Optional global overrides
# PALLIUM_DEFAULT_USE_CASE=agent_conversation_memory
# PALLIUM_STORAGE_BACKEND=sqlite
# PALLIUM_SQLITE_URL=sqlite:///./pallium.db
# PALLIUM_CONFIG_FILE=pallium.local.toml
# PALLIUM_OBSERVABILITY_INTEGRATION_DEBUG=false
# PALLIUM_RETENTION_ENABLED=false

# Optional package-scoped overrides
# PALLIUM_PACKAGE__AGENT_CONVERSATION_MEMORY__MODEL=gpt-5-mini
# PALLIUM_PACKAGE__AGENT_CONVERSATION_MEMORY__PROMPT_VARIANT=strict_typed_memory_v6_work_state_examples
# PALLIUM_PACKAGE__AGENT_CONVERSATION_MEMORY__PROMPT_VARIANTS__QUERY_AMBIGUITY_RESOLUTION=qar_v1_compact_contract
# PALLIUM_PACKAGE__AGENT_CONVERSATION_MEMORY__RESOLVER_ENABLED=true
# PALLIUM_PACKAGE__AGENT_CONVERSATION_MEMORY__RESOLVER_TIMEOUT_MS=800
# PALLIUM_PACKAGE__LLM_AGENT_MEMORY__PROMPT_VARIANT=strict_typed_memory_v5_compact_examples

# Optional provider-scoped overrides
# PALLIUM_PROVIDER__OPENAI__KIND=openai_compatible
# PALLIUM_PROVIDER__OPENAI__BASE_URL=https://api.openai.com/v1
# PALLIUM_PROVIDER__OPENAI__TIMEOUT_SECONDS=30
# PALLIUM_PROVIDER__OPENAI__MAX_ATTEMPTS=3
# PALLIUM_PROVIDER__OPENAI__BASE_BACKOFF_MS=250
# PALLIUM_PROVIDER__OPENAI__MAX_BACKOFF_MS=3000
# PALLIUM_PROVIDER__OPENAI__JITTER_RATIO=0.2
# PALLIUM_PROVIDER__OPENAI__MAX_CONCURRENCY=4
